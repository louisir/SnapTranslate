<Window x:Class="SnapTranslate.UI.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapTranslate"
        Width="380"
        SizeToContent="Height"
        MaxHeight="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border Padding="14"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#3D89C8"
            Background="#F7FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              ShadowDepth="4"
                              Opacity="0.28"/>
        </Border.Effect>
        <ScrollViewer MaxHeight="280"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="SourceText"
                           FontSize="13"
                           Foreground="#1F2933"
                           TextWrapping="Wrap"/>
                <Separator Margin="0,8,0,8"/>
                <TextBlock x:Name="TranslatedText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#0F5F68"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusText"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="#77838F"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
